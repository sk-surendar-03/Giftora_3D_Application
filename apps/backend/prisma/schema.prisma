// Giftora backend database schema.
// Migrated from PostgreSQL to MySQL 8.0 in Phase 17 (no PostgreSQL data or
// migration history existed to carry over — see DEVELOPMENT_PROGRESS.md).
// Run `npx prisma migrate dev --name init` against a real DATABASE_URL to
// create the actual database tables — not run in this environment (no
// reachable MySQL instance here).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

// Whether a cart/order line is a catalog product, a standalone customer-
// created keychain design, or a standalone customer-created 3D stand design.
enum OrderItemType {
  PRODUCT
  CUSTOM_DESIGN
  STAND_DESIGN
}

// PENDING until the generated STL has been uploaded, validated and stored.
enum DesignStatus {
  PENDING
  READY
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role     @default(CUSTOMER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses     Address[]
  cart          Cart?
  orders        Order[]
  customDesigns CustomDesign[]
  standDesigns  StandDesign[]
  wishlistItems WishlistItem[]

  @@map("users")
}

model CustomDesign {
  id               String       @id @default(cuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  schemaVersion    Int          @default(1)
  title            String
  params           Json
  engineParams     Json
  paramsHash       String
  unitPriceCents   Int
  status           DesignStatus @default(PENDING)
  stlKey           String?      @unique
  stlSha256        String?
  stlSizeBytes     Int?
  triangleCount    Int?
  bboxMm           Json?
  reliefStlKey     String?      @unique
  reliefStlSha256  String?
  reliefStlBytes   Int?
  previewKey       String?
  previewSizeBytes Int?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([userId, paramsHash])
  @@index([userId])
  @@map("custom_designs")
}

// A standalone customer-created 3D stand design (Phone Stand, Pen Holder,
// Combined, Desk Organizer, Personalized Gift). The full DesignConfig JSON
// lives in `designConfig` because it holds ~40 parameters across phone, pen,
// combined, personalization, appearance, and print — mirroring into typed
// columns would be brittle. STL is generated client-side, content-addressed,
// and SHA-256 verified, same pattern as CustomDesign.
model StandDesign {
  id               String       @id @default(cuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  schemaVersion    Int          @default(1)
  title            String
  category         String       @db.VarChar(40)
  designConfig     Json
  paramsHash       String
  unitPriceCents   Int
  status           DesignStatus @default(PENDING)
  stlKey           String?      @unique
  stlSha256        String?
  stlSizeBytes     Int?
  triangleCount    Int?
  bboxMm           Json?
  previewKey       String?
  previewSizeBytes Int?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([userId, paramsHash])
  @@index([userId])
  @@index([status])
  @@map("stand_designs")
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String   @db.Text
  priceCents        Int
  originalPriceCents Int?
  shippingCents     Int      @default(0)
  images           Json     @default("[]")
  materials        Json     @default("[]")
  sizes            Json     @default("[]")
  colorsByMaterial Json?
  materialOptions  Json?
  sizeOptions      Json?
  shippingMethods  Json?
  imageMaterials   Json?
  modelKey       String?  @db.VarChar(255)
  modelFilename  String?  @db.VarChar(255)
  modelFormat    String?  @db.VarChar(10)
  modelSizeBytes Int?
  isActive    Boolean  @default(true)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cartItems     CartItem[]
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]

  @@index([categoryId])
  @@map("products")
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orders Order[]

  @@index([userId])
  @@map("addresses")
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id             String   @id @default(cuid())
  cartId         String
  cart           Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  itemType       OrderItemType @default(PRODUCT)
  productId      String?
  product        Product?      @relation(fields: [productId], references: [id], onDelete: Restrict)
  customDesignId String?
  customDesign   CustomDesign? @relation(fields: [customDesignId], references: [id], onDelete: Restrict)
  standDesignId  String?
  standDesign    StandDesign?  @relation(fields: [standDesignId], references: [id], onDelete: Restrict)
  quantity       Int      @default(1)
  customization  Json?
  unitPriceCents Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([cartId])
  @@index([productId])
  @@index([customDesignId])
  @@index([standDesignId])
  @@map("cart_items")
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  idempotencyKey  String?     @unique
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  addressId       String?
  address         Address?    @relation(fields: [addressId], references: [id], onDelete: SetNull)
  shippingAddress Json
  status          OrderStatus @default(PENDING)
  shippingCarrier String?
  trackingNumber  String?
  trackingUrl     String?     @db.Text
  customerNote    String?     @db.Text
  subtotalCents   Int
  shippingCents   Int         @default(0)
  totalCents      Int
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items   OrderItem[]
  payment Payment?

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemType       OrderItemType @default(PRODUCT)
  productId      String?
  product        Product?      @relation(fields: [productId], references: [id], onDelete: Restrict)
  customDesignId String?
  customDesign   CustomDesign? @relation(fields: [customDesignId], references: [id], onDelete: Restrict)
  standDesignId  String?
  standDesign    StandDesign?  @relation(fields: [standDesignId], references: [id], onDelete: Restrict)
  productName    String
  productSlug    String?
  productImage   String?
  quantity       Int
  customization  Json?
  unitPriceCents Int

  @@index([orderId])
  @@index([productId])
  @@index([customDesignId])
  @@index([standDesignId])
  @@map("order_items")
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String        @unique
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider        String
  providerRef     String?
  amountCents     Int
  status          PaymentStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("payments")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("wishlist_items")
}

model ContactInquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  subject   String
  message   String   @db.Text
  status    String   @default("NEW")
  createdAt DateTime @default(now())

  @@map("contact_inquiries")
}